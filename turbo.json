{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "enabled": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "passThroughEnv": [
        "NODE_ENV",
        "DATABASE_URL",
        "DIRECT_URL",
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_KEY",
        "REDIS_URL",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "JWT_ACCESS_EXPIRATION",
        "JWT_REFRESH_EXPIRATION",
        "APP_PORT",
        "APP_URL",
        "FRONTEND_URL",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "VERIFACTU_ENVIRONMENT",
        "VERIFACTU_ENDPOINT_SANDBOX",
        "VERIFACTU_ENDPOINT_PRODUCTION",
        "CERTIFICATE_ENCRYPTION_KEY",
        "UPLOAD_DIR",
        "SCHEDULER_SECRET",
        "PARTNER_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
