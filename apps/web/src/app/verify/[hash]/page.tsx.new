import type { Metadata } from 'next';
import Link from 'next/link';
import Image from 'next/image';
import {
  CheckCircle2,
  XCircle,
  ShieldCheck,
  ExternalLink,
  Hash,
  Calendar,
  Receipt,
  Building2,
  FileText,
  Euro,
  Clock,
} from 'lucide-react';
import { verifyInvoiceByHash } from '@/lib/api/public-verify-api';
import { InvoiceStatus } from '@easyfactura/shared-types';
import { brandConfig } from '@easyfactura/brand-config';

interface Props {
  params: Promise<{ hash: string }>;
}

export async function generateMetadata({ params }: Props): Promise<Metadata> {
  const { hash } = await params;
  return {
    title: `Verificar factura | ${brandConfig.app.name}`,
    description: 'Verifica la autenticidad e integridad de esta factura electrónica.',
    robots: { index: false, follow: false },
    openGraph: {
      title: `Verificación de factura | ${brandConfig.app.name}`,
      description: 'Comprueba que esta factura es auténtica y no ha sido alterada.',
      url: `${brandConfig.app.url}/verify/${hash}`,
    },
  };
}

const STATUS_LABELS: Partial<Record<InvoiceStatus, string>> = {
  [InvoiceStatus.CONFIRMED]: 'Emitida',
  [InvoiceStatus.SENT]: 'Enviada',
  [InvoiceStatus.PAID]: 'Pagada',
};

export default async function VerifyPage({ params }: Props) {
  const { hash: rawHash } = await params;
  // Normalise to lowercase so QR codes that encode uppercase hex still work
  const hash = rawHash.toLowerCase();

  // Basic format validation before hitting the API
  const isValidHash = /^[0-9a-f]{64}$/.test(hash);

  if (!isValidHash) {
    return <NotFoundState />;
  }

  let data: Awaited<ReturnType<typeof verifyInvoiceByHash>>;
  try {
    data = await verifyInvoiceByHash(hash);
  } catch {
    return <ErrorState />;
  }

  if (!data) {
    return <NotFoundState />;
  }

  const statusLabel = STATUS_LABELS[data.invoice.status] ?? data.invoice.status;
  const issueDateFormatted = new Date(data.invoice.issueDate).toLocaleDateString('es-ES', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
  });
  const confirmedAtFormatted = new Date(data.confirmedAt).toLocaleString('es-ES', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
  const fmtCurrency = (n: number) =>
    `${n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${data!.invoice.currency}`;

  return (
    <PageShell>
      {/* Hero card */}
      <div className="relative overflow-hidden rounded-2xl border border-emerald-200/60 bg-gradient-to-br from-emerald-50 via-white to-white dark:from-emerald-950/40 dark:via-background dark:to-background dark:border-emerald-900/50 shadow-sm">
        <div className="absolute inset-0 bg-[radial-gradient(circle_at_top_right,theme(colors.emerald.200/.4),transparent_50%)] dark:bg-[radial-gradient(circle_at_top_right,theme(colors.emerald.900/.3),transparent_50%)] pointer-events-none" />
        <div className="relative px-6 py-7 flex flex-col items-center text-center">
          <div className="flex items-center justify-center w-16 h-16 rounded-full bg-emerald-500/10 ring-8 ring-emerald-500/5 mb-3">
            <CheckCircle2 className="w-9 h-9 text-emerald-600 dark:text-emerald-400" strokeWidth={2.25} />
          </div>
          <h1 className="text-2xl font-bold tracking-tight">Factura verificada</h1>
          <p className="text-sm text-muted-foreground max-w-md mt-1.5">
            Esta factura existe en nuestro registro y su integridad criptográfica ha sido comprobada.
          </p>

          {/* Quick summary chips */}
          <div className="flex flex-wrap items-center justify-center gap-2 mt-5">
            <Chip icon={<FileText className="w-3.5 h-3.5" />}>
              {data.invoice.number}
            </Chip>
            <Chip icon={<Euro className="w-3.5 h-3.5" />}>
              {fmtCurrency(data.invoice.total)}
            </Chip>
            <StatusChip status={data.invoice.status} label={statusLabel} />
          </div>
        </div>
      </div>

      {/* Issuer block */}
      <SectionTitle icon={<Building2 className="w-4 h-4" />}>Emisor</SectionTitle>
      <Card>
        <Row label="Razón comercial" value={data.issuer.tradeName} />
        <Row label="NIF / CIF" value={data.issuer.nifMasked} mono />
      </Card>

      {/* Invoice block */}
      <SectionTitle icon={<Receipt className="w-4 h-4" />}>Factura</SectionTitle>
      <Card>
        <Row label="Número" value={data.invoice.number} />
        {data.invoice.series && <Row label="Serie" value={data.invoice.series} />}
        <Row
          label="Fecha de emisión"
          value={issueDateFormatted}
          icon={<Calendar className="w-3.5 h-3.5 text-muted-foreground" />}
        />
        <Row label="Base imponible" value={fmtCurrency(data.invoice.subtotal)} />
        <Row label="IVA" value={fmtCurrency(data.invoice.taxTotal)} />
        <Row
          label="Importe total"
          value={fmtCurrency(data.invoice.total)}
          emphasis
        />
        <Row label="Estado" value={statusLabel} />
      </Card>

      {/* Integrity block */}
      <SectionTitle icon={<ShieldCheck className="w-4 h-4" />}>Integridad</SectionTitle>
      <Card>
        <Row
          label="Registrada el"
          value={confirmedAtFormatted}
          icon={<Clock className="w-3.5 h-3.5 text-muted-foreground" />}
        />
        <div className="px-4 py-3 flex flex-col gap-1.5">
          <div className="flex items-center gap-1.5 text-muted-foreground text-xs uppercase tracking-wide">
            <Hash className="w-3.5 h-3.5" />
            <span>Huella SHA-256</span>
          </div>
          <code
            className="block font-mono text-[11px] leading-relaxed text-foreground/80 break-all bg-muted/50 rounded-md px-2.5 py-2 select-all"
            title="Hash criptográfico completo. Cualquier alteración de la factura cambiaría este valor."
          >
            {data.hashFull}
          </code>
        </div>
      </Card>

      {/* Disclaimer */}
      <div className="mt-6 rounded-xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/60 px-4 py-3.5 text-xs text-amber-900 dark:text-amber-200 flex gap-2.5">
        <ShieldCheck className="w-4 h-4 shrink-0 mt-0.5 text-amber-600 dark:text-amber-400" />
        <span className="leading-relaxed">
          Esta es una verificación interna de <strong>{brandConfig.app.name}</strong>. La factura
          aún no está registrada en la AEAT como VeriFactu — integración en proceso.
        </span>
      </div>

      <PageFooter />
    </PageShell>
  );
}

// ============================================================
// Sub-components
// ============================================================

function Chip({ icon, children }: { icon?: React.ReactNode; children: React.ReactNode }) {
  return (
    <span className="inline-flex items-center gap-1.5 rounded-full bg-white dark:bg-card border border-border/80 px-3 py-1 text-xs font-medium text-foreground/90 shadow-sm">
      {icon}
      {children}
    </span>
  );
}

function StatusChip({ status, label }: { status: InvoiceStatus; label: string }) {
  const isPaid = status === InvoiceStatus.PAID;
  const isSent = status === InvoiceStatus.SENT;
  const className = isPaid
    ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/30'
    : isSent
      ? 'bg-sky-500/10 text-sky-700 dark:text-sky-400 border-sky-500/30'
      : 'bg-slate-500/10 text-slate-700 dark:text-slate-300 border-slate-500/30';
  return (
    <span
      className={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium shadow-sm ${className}`}
    >
      <CheckCircle2 className="w-3.5 h-3.5" />
      {label}
    </span>
  );
}

function SectionTitle({
  icon,
  children,
}: {
  icon: React.ReactNode;
  children: React.ReactNode;
}) {
  return (
    <h2 className="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground mt-6 mb-2 px-1">
      {icon}
      {children}
    </h2>
  );
}

function Card({ children }: { children: React.ReactNode }) {
  return (
    <div className="w-full rounded-xl border bg-card divide-y text-sm shadow-sm">{children}</div>
  );
}

function Row({
  label,
  value,
  mono = false,
  emphasis = false,
  icon,
  title,
}: {
  label: string;
  value: string;
  mono?: boolean;
  emphasis?: boolean;
  icon?: React.ReactNode;
  title?: string;
}) {
  return (
    <div className="flex items-center justify-between gap-4 px-4 py-3">
      <span className="flex items-center gap-1.5 text-muted-foreground shrink-0">
        {icon}
        {label}
      </span>
      <span
        className={[
          'text-right font-medium',
          mono ? 'font-mono text-xs' : '',
          emphasis ? 'text-base font-semibold text-foreground' : '',
        ]
          .filter(Boolean)
          .join(' ')}
        title={title}
      >
        {value}
      </span>
    </div>
  );
}

function NotFoundState() {
  return (
    <PageShell>
      <div className="flex flex-col items-center text-center gap-3 py-10">
        <div className="flex items-center justify-center w-16 h-16 rounded-full bg-red-500/10 ring-8 ring-red-500/5">
          <XCircle className="w-9 h-9 text-red-500 dark:text-red-400" strokeWidth={2.25} />
        </div>
        <h1 className="text-xl font-semibold">Factura no encontrada</h1>
        <p className="text-sm text-muted-foreground max-w-sm">
          No hemos podido verificar esta factura. Es posible que el enlace sea incorrecto o que la
          factura no exista en nuestro sistema.
        </p>
        <Link
          href={brandConfig.app.url}
          className="mt-2 inline-flex items-center gap-1.5 text-sm text-primary hover:underline"
        >
          <ExternalLink className="w-3.5 h-3.5" />
          Ir a {brandConfig.app.name}
        </Link>
      </div>
      <PageFooter />
    </PageShell>
  );
}

function ErrorState() {
  return (
    <PageShell>
      <div className="flex flex-col items-center text-center gap-3 py-10">
        <div className="flex items-center justify-center w-16 h-16 rounded-full bg-red-500/10 ring-8 ring-red-500/5">
          <XCircle className="w-9 h-9 text-red-500 dark:text-red-400" strokeWidth={2.25} />
        </div>
        <h1 className="text-xl font-semibold">Error de verificación</h1>
        <p className="text-sm text-muted-foreground max-w-sm">
          No hemos podido completar la verificación en este momento. Inténtalo de nuevo en unos
          minutos.
        </p>
      </div>
      <PageFooter />
    </PageShell>
  );
}

function PageShell({ children }: { children: React.ReactNode }) {
  return (
    <div className="min-h-screen bg-gradient-to-b from-muted/30 via-background to-background">
      {/* Top brand bar */}
      <header className="border-b bg-background/70 backdrop-blur supports-[backdrop-filter]:bg-background/60 sticky top-0 z-10">
        <div className="mx-auto max-w-3xl px-4 h-14 flex items-center justify-between">
          <Link href={brandConfig.app.url} className="flex items-center gap-2">
            <Image
              src={brandConfig.logos.main}
              alt={brandConfig.app.name}
              width={28}
              height={28}
              className="rounded-md"
              priority
            />
            <span className="text-sm font-semibold tracking-tight">{brandConfig.app.name}</span>
          </Link>
          <span className="hidden sm:inline-flex items-center gap-1.5 text-xs text-muted-foreground">
            <ShieldCheck className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
            Verificación pública
          </span>
        </div>
      </header>

      <main className="mx-auto max-w-xl px-4 py-10 sm:py-14">{children}</main>
    </div>
  );
}

function PageFooter() {
  return (
    <div className="mt-8 text-xs text-muted-foreground text-center space-y-1">
      <p>
        Verificación proporcionada por{' '}
        <Link href={brandConfig.app.url} className="font-medium text-foreground hover:underline">
          {brandConfig.app.name}
        </Link>
      </p>
      <p className="text-[11px] opacity-70">
        Esta página no almacena cookies ni rastreadores.
      </p>
    </div>
  );
}
