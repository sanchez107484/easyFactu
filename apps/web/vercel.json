{
  "buildCommand": "cd ../.. && turbo build --filter=@easyfactura/web",
  "installCommand": "pnpm install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.novafactura.es" }],
      "destination": "https://novafactura.es/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "src/app/api/invoices/[id]/pdf/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
