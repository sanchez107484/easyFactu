# Marca activa — controla qué brand config y tema se carga en el build
# Valores: 'novafactura' (por defecto) | 'nafactura'
# NovaFactura: NEXT_PUBLIC_BRAND=novafactura
# NaFactura:   NEXT_PUBLIC_BRAND=nafactura
NEXT_PUBLIC_BRAND="novafactura"

# API
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sanity CMS (Blog)
# Obtén estos valores en https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID="tu-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"
# Genera un secreto aleatorio y configúralo también en Sanity > API > Webhooks
SANITY_REVALIDATE_SECRET=""

# Google Tag Manager
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Chat de ayuda del dashboard. Solo disponible en NovaFactura: en NaFactura no aparece aunque valga "true".
NEXT_PUBLIC_HELP_CHAT_ENABLED="false"
# URL del webhook de n8n que responde al chat. Solo de servidor: nunca con el prefijo NEXT_PUBLIC_.
N8N_SUPPORT_CHAT_WEBHOOK_URL=""



