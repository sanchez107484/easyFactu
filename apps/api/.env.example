# Database (Supabase PostgreSQL)
# IMPORTANTE — conexión a través de Transaction Pooler (puerto 6543) con pgBouncer.
# Esto es imprescindible en Vercel (serverless) para no agotar las conexiones de Supabase.
# Obtener de: Supabase Dashboard > Settings > Database > Transaction pooler (URI)
# El parámetro connection_limit=1 es obligatorio para Prisma en entornos serverless.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection for Prisma migrations (usa el host directo, NO el pooler)
# Obtener de: Supabase Dashboard > Settings > Database > Direct connection (URI)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase
# Obtener de: Supabase Dashboard > Settings > API
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGc..."  # Public anon key
SUPABASE_SERVICE_KEY="eyJhbGc..."  # Service role key (privada, solo backend)

# Redis (Upstash en producción, Docker en desarrollo)
REDIS_URL="redis://localhost:6379"
# REDIS_URL="rediss://default:[PASSWORD]@[REGION].upstash.io:6379"  # Producción

# JWT
JWT_ACCESS_SECRET="your-access-secret-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# App
NODE_ENV="development"
APP_PORT=3001
APP_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# Storage (Supabase Storage)
# Configurado automáticamente con SUPABASE_URL y SUPABASE_SERVICE_KEY
# Buckets necesarios: certificates (private), invoices (private)

# Email (Resend)
# Obtener de: https://resend.com/api-keys
RESEND_API_KEY=""
# En desarrollo: usar "NovaFactura <onboarding@resend.dev>" hasta verificar el dominio
# En producción: "NovaFactura <noreply@novafactura.es>" (requiere dominio verificado en Resend)
EMAIL_FROM="NovaFactura <noreply@novafactura.es>"

# VeriFactu AEAT
VERIFACTU_ENVIRONMENT="sandbox"
VERIFACTU_ENDPOINT_SANDBOX="https://prewww10.aeat.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/RegistroFacturacion"
VERIFACTU_ENDPOINT_PRODUCTION="https://www10.aeat.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/RegistroFacturacion"

# Encryption (for certificates) - MUST be 32 bytes in hex (64 hex characters)
CERTIFICATE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# File uploads
UPLOAD_DIR="uploads"  # Directory for uploaded files (logos and certificates)

# Recurring Invoices Scheduler (used to secure POST /recurring-invoices/trigger-scheduler)
# Set a strong random secret in production (e.g. openssl rand -hex 32)
SCHEDULER_SECRET="change-me-in-production"

# Partner Dashboard — secret key required in X-Partner-Key header to access /api/v1/partner/stats
# Set a strong random secret (e.g. openssl rand -hex 32)
PARTNER_SECRET="change-me-in-production"
