{
  "version": 2,
  "buildCommand": "prisma migrate deploy --schema=./prisma/schema.prisma && turbo run build --filter=@easyfactura/backend",
  "installCommand": "pnpm install --frozen-lockfile --prefer-offline",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**,node_modules/.prisma/**,node_modules/.pnpm/@prisma+client@*/node_modules/.prisma/**,node_modules/@easyfactura/**",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
