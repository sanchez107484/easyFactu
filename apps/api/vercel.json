{
  "version": 2,
  "buildCommand": "pnpm exec nest build",
  "installCommand": "pnpm install",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
