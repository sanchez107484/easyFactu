generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                        String                   @id @default(uuid())
  businessName              String                   @map("business_name")
  legalName                 String?                  @map("legal_name")
  nif                       String                   @unique
  address                   String
  postalCode                String                   @map("postal_code")
  city                      String
  province                  String
  country                   String                   @default("ES")
  phone                     String?
  email                     String
  logoUrl                   String?                  @map("logo_url")
  iban                      String?
  bankAccountHolder         String?                  @map("bank_account_holder")
  certificateUrl            String?                  @map("certificate_url")
  certificateExpiry         DateTime?                @map("certificate_expiry")
  setupCompleted            Boolean                  @default(false) @map("setup_completed")
  accountType               AccountType              @default(INDIVIDUAL) @map("account_type")
  isActive                  Boolean                  @default(true) @map("is_active")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  bic                       String?
  preferredExportFormat     ExportFormat?            @map("preferred_export_format")
  taxRegime                 TaxRegime                @default(GENERAL) @map("tax_regime")
  reaypRate                 Decimal?                 @map("reagyp_rate") @db.Decimal(5, 2)
  agencyRelations           AgencyClientRelation[]   @relation("AgencyRelations")
  clientRelations           AgencyClientRelation[]   @relation("ClientRelations")
  agencyExportLogs          AgencyExportLog[]        @relation("AgencyExportLogs")
  clientExportLogs          AgencyExportLog[]        @relation("ClientExportLogs")
  impersonationLogsAsAgency AgencyImpersonationLog[] @relation("ImpersonationAgencyTenant")
  impersonationLogsAsClient AgencyImpersonationLog[] @relation("ImpersonationClientTenant")
  agencyInvitations         AgencyInvitation[]
  agencyRelationHistory     AgencyRelationHistory[]  @relation("AgencyHistoryRelations")
  clientRelationHistory     AgencyRelationHistory[]  @relation("ClientHistoryRelations")
  customers                 Customer[]
  expenseAttachments        ExpenseAttachment[]
  expenses                  Expense[]
  invoiceDefaults           InvoiceDefaults?
  agencyExportEvents        InvoiceExportEvent[]     @relation("AgencyExportEvents")
  clientExportEvents        InvoiceExportEvent[]     @relation("ClientExportEvents")
  invoiceNoteLogs           InvoiceNoteLog[]
  invoiceSeries             InvoiceSeries[]
  invoiceTemplates          InvoiceTemplate[]
  invoices                  Invoice[]
  payments                  Payment[]
  products                  Product[]
  recurringExpenses         RecurringExpense[]
  recurringInvoices         RecurringInvoice[]
  subscription              Subscription?
  suppliers                 Supplier[]
  tenantUsers               TenantUser[]
  verifactuLogs             VerifactuLog[]

  @@index([email])
  @@index([accountType])
  @@map("tenants")
}

model Plan {
  id             String          @id @default(dbgenerated("(uuid_generate_v4())::text"))
  slug           String          @unique
  name           String
  cycle          PlanCycle
  tier           PlanTier
  limits         Json            @default("{\"allowExpenses\": false, \"maxInvoicesPerYear\": null}")
  isActive       Boolean         @default(true)  @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  changeLogsFrom PlanChangeLog[] @relation("PlanChangeFrom")
  changeLogsTo   PlanChangeLog[] @relation("PlanChangeTo")
  subscriptions  Subscription[]

  @@index([cycle])
  @@index([tier])
  @@map("plans")
}

model Subscription {
  id                  String             @id @default(dbgenerated("(uuid_generate_v4())::text"))
  tenantId            String             @unique @map("tenant_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(ACTIVE)
  billingCycle       PlanCycle          @map("billing_cycle")
  startedAt          DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  changedAt          DateTime           @default(now()) @updatedAt @map("changed_at") @db.Timestamptz(6)
  preferredPlanSlug  String?            @map("preferred_plan_slug")
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: NoAction)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model PlanChangeLog {
  id         String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  tenantId   String   @map("tenant_id")
  fromPlanId String?  @map("from_plan_id")
  toPlanId   String   @map("to_plan_id")
  changedBy  String   @map("changed_by")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  fromPlan   Plan?    @relation("PlanChangeFrom", fields: [fromPlanId], references: [id], onUpdate: SetNull)
  toPlan     Plan     @relation("PlanChangeTo", fields: [toPlanId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
  @@map("plan_change_logs")
}

model TenantUser {
  id        String         @id @default(uuid())
  tenantId  String         @map("tenant_id")
  userId    String         @map("user_id")
  role      TenantUserRole @default(ADMIN)
  isOwner   Boolean        @default(false) @map("is_owner")
  joinedAt  DateTime       @default(now()) @map("joined_at")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_users")
}

model User {
  id                       String                   @id @default(uuid())
  email                    String                   @unique
  passwordHash             String?                  @map("password_hash")
  firstName                String                   @default("") @map("first_name")
  lastName                 String                   @default("") @map("last_name")
  emailVerified            Boolean                  @default(false) @map("email_verified")
  emailVerifyToken         String?                  @map("email_verify_token")
  resetPasswordToken       String?                  @map("reset_password_token")
  resetPasswordExpires     DateTime?                @map("reset_password_expires")
  refreshToken             String?                  @map("refresh_token")
  isActive                 Boolean                  @default(true) @map("is_active")
  lastLoginAt              DateTime?                @map("last_login_at")
  lastActiveTenantId       String?                  @map("last_active_tenant_id")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  accountActivationExpires DateTime?                @map("account_activation_expires")
  accountActivationToken   String?                  @map("account_activation_token")
  agencyExportLogs         AgencyExportLog[]        @relation("AgencyExportLogUser")
  impersonationLogs        AgencyImpersonationLog[] @relation("ImpersonationActor")
  expensesCreated          Expense[]                @relation("ExpenseCreatedBy")
  invoiceExportEvents      InvoiceExportEvent[]     @relation("InvoiceExportEventUser")
  invoicesCreated          Invoice[]                @relation("InvoiceCreatedBy")
  recurringExpensesCreated RecurringExpense[]       @relation("RecurringExpenseCreatedBy")
  recurringInvoicesCreated RecurringInvoice[]       @relation("RecurringInvoiceCreatedBy")
  tenantUsers              TenantUser[]

  @@map("users")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Customer {
  id                      String             @id @default(uuid())
  tenantId                String             @map("tenant_id")
  type                    CustomerType       @default(COMPANY)
  name                    String
  legalName               String?            @map("legal_name")
  nif                     String
  email                   String?
  phone                   String?
  address                 String?
  postalCode              String?            @map("postal_code")
  city                    String?
  province                String?
  country                 String             @default("ES")
  contactPerson           String?            @map("contact_person")
  notes                   String?
  isActive                Boolean            @default(true) @map("is_active")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  isReagyp                Boolean            @default(false) @map("is_reagyp")
  hasEquivalenceSurcharge Boolean            @default(false) @map("has_equivalence_surcharge")
  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses                Expense[]
  invoices                Invoice[]
  recurringExpenses       RecurringExpense[]
  recurringInvoices       RecurringInvoice[]

  @@unique([tenantId, nif])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "customers_name_trgm_idx", type: Gin)
  @@index([legalName(ops: raw("gin_trgm_ops"))], map: "customers_legal_name_trgm_idx", type: Gin)
  @@index([nif(ops: raw("gin_trgm_ops"))], map: "customers_nif_trgm_idx", type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], map: "customers_email_trgm_idx", type: Gin)
  @@map("customers")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Product {
  id             String                 @id @default(uuid())
  tenantId       String                 @map("tenant_id")
  type           ProductType            @default(SERVICE)
  name           String
  description    String?
  reference      String?
  unitPrice      Decimal                @map("unit_price") @db.Decimal(12, 4)
  taxRate        Decimal                @map("tax_rate") @db.Decimal(5, 2)
  unit           String                 @default("unidad")
  isActive       Boolean                @default(true) @map("is_active")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  invoiceLines   InvoiceLine[]
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recurringLines RecurringInvoiceLine[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "products_name_trgm_idx", type: Gin)
  @@index([reference(ops: raw("gin_trgm_ops"))], map: "products_reference_trgm_idx", type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], map: "products_description_trgm_idx", type: Gin)
  @@map("products")
}

model InvoiceTemplate {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  name      String    @default("Plantilla predeterminada")
  isDefault Boolean   @default(false) @map("is_default")
  layout    Json
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices  Invoice[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isDefault])
  @@map("invoice_templates")
}

model InvoiceSeries {
  id                String             @id @default(uuid())
  tenantId          String             @map("tenant_id")
  code              String
  name              String
  type              SeriesType         @default(INVOICE)
  prefix            String
  nextNumber        Int                @default(1) @map("next_number")
  digits            Int                @default(4)
  year              Int
  isDefault         Boolean            @default(false) @map("is_default")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]

  @@unique([tenantId, code, year])
  @@index([tenantId])
  @@index([tenantId, isDefault])
  @@map("invoice_series")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Invoice {
  id                         String                 @id @default(uuid())
  tenantId                   String                 @map("tenant_id")
  seriesId                   String                 @map("series_id")
  customerId                 String                 @map("customer_id")
  number                     String?
  issueDate                  DateTime               @map("issue_date") @db.Date
  dueDate                    DateTime?              @map("due_date") @db.Date
  status                     InvoiceStatus          @default(DRAFT)
  subtotal                   Decimal                @db.Decimal(12, 2)
  discountPercent            Decimal?               @map("discount_percent") @db.Decimal(5, 2)
  discountAmount             Decimal?               @map("discount_amount") @db.Decimal(12, 2)
  taxTotal                   Decimal                @map("tax_total") @db.Decimal(12, 2)
  irpfPercent                Decimal?               @map("irpf_percent") @db.Decimal(5, 2)
  irpfTotal                  Decimal?               @map("irpf_total") @db.Decimal(12, 2)
  total                      Decimal                @db.Decimal(12, 2)
  paymentMethod              PaymentMethod?         @map("payment_method")
  notes                      String?
  templateId                 String?                @map("template_id")
  pdfUrl                     String?                @map("pdf_url")
  hash                       String?                @unique
  prevHash                   String?                @map("prev_hash")
  verifactuStatus            VerifactuStatus?       @map("verifactu_status")
  verifactuQr                String?                @map("verifactu_qr")
  verifactuSentAt            DateTime?              @map("verifactu_sent_at")
  verifactuResponse          Json?                  @map("verifactu_response")
  isRectificative            Boolean                @default(false) @map("is_rectificative")
  rectifiedInvoiceId         String?                @map("rectified_invoice_id")
  rectificationReason        String?                @map("rectification_reason")
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  paymentDetails             Json?                  @map("payment_details")
  invoiceType                InvoiceType            @default(standard) @map("invoice_type")
  validUntil                 DateTime?              @map("valid_until") @db.Date
  quoteAcceptanceStatus      QuoteAcceptanceStatus? @map("quote_acceptance_status")
  convertedToInvoiceId       String?                @map("converted_to_invoice_id")
  layoutOverride             Json?                  @map("layout_override")
  recurringInvoiceId         String?                @map("recurring_invoice_id")
  amountPaid                 Decimal                @default(0) @map("amount_paid") @db.Decimal(12, 2)
  paymentStatus              PaymentStatus          @default(UNPAID) @map("payment_status")
  createdByUserId            String?                @map("created_by_user_id")
  customerSnapshotName       String?                @map("customer_snapshot_name")
  customerSnapshotLegalName  String?                @map("customer_snapshot_legal_name")
  customerSnapshotNif        String?                @map("customer_snapshot_nif")
  customerSnapshotType       String?                @map("customer_snapshot_type")
  customerSnapshotEmail      String?                @map("customer_snapshot_email")
  customerSnapshotPhone      String?                @map("customer_snapshot_phone")
  customerSnapshotAddress    String?                @map("customer_snapshot_address")
  customerSnapshotPostalCode String?                @map("customer_snapshot_postal_code")
  customerSnapshotCity       String?                @map("customer_snapshot_city")
  customerSnapshotProvince   String?                @map("customer_snapshot_province")
  customerSnapshotCountry    String?                @map("customer_snapshot_country")
  issuerSnapshotName         String?                @map("issuer_snapshot_name")
  issuerSnapshotLegalName    String?                @map("issuer_snapshot_legal_name")
  issuerSnapshotNif          String?                @map("issuer_snapshot_nif")
  issuerSnapshotEmail        String?                @map("issuer_snapshot_email")
  issuerSnapshotPhone        String?                @map("issuer_snapshot_phone")
  issuerSnapshotAddress      String?                @map("issuer_snapshot_address")
  issuerSnapshotPostalCode   String?                @map("issuer_snapshot_postal_code")
  issuerSnapshotCity         String?                @map("issuer_snapshot_city")
  issuerSnapshotProvince     String?                @map("issuer_snapshot_province")
  issuerSnapshotCountry      String?                @map("issuer_snapshot_country")
  compensacionPercent        Decimal?               @map("compensacion_percent") @db.Decimal(5, 2)
  compensacionAmount         Decimal?               @map("compensacion_amount") @db.Decimal(12, 2)
  surchargeTotal             Decimal?               @map("surcharge_total") @db.Decimal(12, 2)
  rectificationType          RectificationType?     @map("rectification_type")
  supersededBySubstitutionId String?                @map("superseded_by_substitution_id")
  exportEvents               InvoiceExportEvent[]
  lines                      InvoiceLine[]
  noteLogs                   InvoiceNoteLog[]
  createdByUser              User?                  @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])
  customer                   Customer               @relation(fields: [customerId], references: [id])
  rectifiedInvoice           Invoice?               @relation("RectifiedInvoice", fields: [rectifiedInvoiceId], references: [id])
  rectificativeInvoices      Invoice[]              @relation("RectifiedInvoice")
  recurringInvoice           RecurringInvoice?      @relation(fields: [recurringInvoiceId], references: [id])
  series                     InvoiceSeries          @relation(fields: [seriesId], references: [id])
  supersededBySubstitution   Invoice?               @relation("SupersededBy", fields: [supersededBySubstitutionId], references: [id])
  supersededInvoices         Invoice[]              @relation("SupersededBy")
  template                   InvoiceTemplate?       @relation(fields: [templateId], references: [id])
  tenant                     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments                   Payment[]
  verifactuLogs              VerifactuLog[]

  @@index([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, issueDate])
  @@index([tenantId, status])
  @@index([tenantId, status, issueDate])
  @@index([tenantId, customerId])
  @@index([tenantId, seriesId])
  @@index([tenantId, dueDate])
  @@index([tenantId, total])
  @@index([tenantId, createdAt])
  @@index([tenantId, paymentStatus])
  @@index([createdByUserId])
  @@index([recurringInvoiceId])
  @@index([number(ops: raw("gin_trgm_ops"))], map: "invoices_number_trgm_idx", type: Gin)
  @@index([supersededBySubstitutionId])
  @@map("invoices")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model InvoiceLine {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  invoiceId       String   @map("invoice_id")
  productId       String?  @map("product_id")
  description     String
  quantity        Decimal  @db.Decimal(12, 4)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 4)
  subtotal        Decimal  @db.Decimal(12, 2)
  taxRate         Decimal  @map("tax_rate") @db.Decimal(5, 2)
  taxAmount       Decimal  @map("tax_amount") @db.Decimal(12, 2)
  irpfRate        Decimal? @map("irpf_rate") @db.Decimal(5, 2)
  irpfAmount      Decimal? @map("irpf_amount") @db.Decimal(12, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(12, 2)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  hideQty         Boolean  @default(false) @map("hide_qty")
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2)
  surchargeAmount Decimal? @map("surcharge_amount") @db.Decimal(12, 2)
  surchargeRate   Decimal? @map("surcharge_rate") @db.Decimal(5, 2)
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([tenantId])
  @@map("invoice_lines")
}

model Payment {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  invoiceId     String         @map("invoice_id")
  amount        Decimal        @db.Decimal(12, 2)
  paymentDate   DateTime       @map("payment_date") @db.Date
  paymentMethod PaymentMethod? @map("payment_method")
  reference     String?
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@map("payments")
}

model VerifactuLog {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  invoiceId    String   @map("invoice_id")
  action       String
  requestXml   String?  @map("request_xml")
  responseXml  String?  @map("response_xml")
  statusCode   Int?     @map("status_code")
  errorMessage String?  @map("error_message")
  attempt      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([invoiceId, createdAt(sort: Desc)], map: "verifactu_logs_invoice_created_at_idx")
  @@index([createdAt])
  @@map("verifactu_logs")
}

model InvoiceDefaults {
  id             String         @id @default(uuid())
  tenantId       String         @unique @map("tenant_id")
  paymentMethod  PaymentMethod? @map("payment_method")
  paymentDetails Json?          @map("payment_details")
  irpfPercent    Decimal?       @map("irpf_percent") @db.Decimal(5, 2)
  dueDays        Int?           @map("due_days")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invoice_defaults")
}

model InvoiceNoteLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  invoiceId     String   @map("invoice_id")
  userId        String   @map("user_id")
  previousNotes String?  @map("previous_notes")
  newNotes      String?  @map("new_notes")
  createdAt     DateTime @default(now()) @map("created_at")
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([tenantId])
  @@map("invoice_note_logs")
}

model AgencyClientRelation {
  id             String   @id @default(uuid())
  agencyTenantId String   @map("agency_tenant_id")
  clientTenantId String   @map("client_tenant_id")
  addedByUserId  String   @map("added_by_user_id")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  agencyTenant   Tenant   @relation("AgencyRelations", fields: [agencyTenantId], references: [id], onDelete: Cascade)
  clientTenant   Tenant   @relation("ClientRelations", fields: [clientTenantId], references: [id], onDelete: Cascade)

  @@unique([agencyTenantId, clientTenantId])
  @@index([agencyTenantId])
  @@index([clientTenantId])
  @@map("agency_client_relations")
}

model AgencyImpersonationLog {
  id                 String    @id @default(uuid())
  agencyTenantId     String    @map("agency_tenant_id")
  clientTenantId     String    @map("client_tenant_id")
  actorUserId        String    @map("actor_user_id")
  actorEmail         String    @map("actor_email")
  clientBusinessName String    @map("client_business_name")
  ipAddress          String?   @map("ip_address")
  userAgent          String?   @map("user_agent")
  startedAt          DateTime  @default(now()) @map("started_at")
  endedAt            DateTime? @map("ended_at")
  actorUser          User      @relation("ImpersonationActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  agencyTenant       Tenant    @relation("ImpersonationAgencyTenant", fields: [agencyTenantId], references: [id], onDelete: Cascade)
  clientTenant       Tenant    @relation("ImpersonationClientTenant", fields: [clientTenantId], references: [id], onDelete: Cascade)

  @@index([agencyTenantId, startedAt(sort: Desc)])
  @@index([clientTenantId, startedAt(sort: Desc)])
  @@index([actorUserId])
  @@map("agency_impersonation_logs")
}

model AgencyInvitation {
  id             String                 @id @default(uuid())
  agencyTenantId String                 @map("agency_tenant_id")
  inviteeEmail   String                 @map("invitee_email")
  inviteeName    String?                @map("invitee_name")
  token          String                 @unique
  status         AgencyInvitationStatus @default(PENDING)
  expiresAt      DateTime               @map("expires_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  rejectedAt     DateTime?              @map("rejected_at")
  agencyTenant   Tenant                 @relation(fields: [agencyTenantId], references: [id], onDelete: Cascade)

  @@index([agencyTenantId])
  @@index([inviteeEmail])
  @@index([token])
  @@map("agency_invitations")
}

model AgencyRelationHistory {
  id                 String              @id @default(uuid())
  agencyTenantId     String              @map("agency_tenant_id")
  clientTenantId     String              @map("client_tenant_id")
  agencyBusinessName String              @map("agency_business_name") @db.VarChar(255)
  clientBusinessName String              @map("client_business_name") @db.VarChar(255)
  clientNif          String              @map("client_nif") @db.VarChar(20)
  startedAt          DateTime            @map("started_at")
  endedAt            DateTime?           @map("ended_at")
  terminatedBy       RelationTerminator? @map("terminated_by")
  terminatedByUserId String?             @map("terminated_by_user_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  agencyTenant       Tenant              @relation("AgencyHistoryRelations", fields: [agencyTenantId], references: [id])
  clientTenant       Tenant              @relation("ClientHistoryRelations", fields: [clientTenantId], references: [id])

  @@index([agencyTenantId])
  @@index([clientTenantId])
  @@index([agencyTenantId, clientTenantId])
  @@index([endedAt])
  @@map("agency_relation_history")
}

model AgencyExportLog {
  id                  String               @id @default(uuid())
  agencyTenantId      String               @map("agency_tenant_id")
  clientTenantId      String               @map("client_tenant_id")
  requestedByUserId   String               @map("requested_by_user_id")
  format              ExportFormat
  year                Int?
  quarter             Int?
  invoicesCount       Int                  @map("invoices_count")
  totalRevenue        Decimal              @map("total_revenue") @db.Decimal(12, 2)
  createdAt           DateTime             @default(now()) @map("created_at")
  dateFrom            DateTime?            @map("date_from") @db.Date
  dateTo              DateTime?            @map("date_to") @db.Date
  mode                ExportMode           @default(PERIOD)
  agencyTenant        Tenant               @relation("AgencyExportLogs", fields: [agencyTenantId], references: [id], onDelete: Cascade)
  clientTenant        Tenant               @relation("ClientExportLogs", fields: [clientTenantId], references: [id], onDelete: Cascade)
  requestedByUser     User                 @relation("AgencyExportLogUser", fields: [requestedByUserId], references: [id])
  invoiceExportEvents InvoiceExportEvent[]

  @@index([agencyTenantId])
  @@index([clientTenantId])
  @@index([agencyTenantId, createdAt])
  @@map("agency_export_logs")
}

model InvoiceExportEvent {
  id               String           @id @default(uuid())
  invoiceId        String           @map("invoice_id")
  agencyTenantId   String           @map("agency_tenant_id")
  clientTenantId   String           @map("client_tenant_id")
  exportLogId      String?          @map("export_log_id")
  format           ExportFormat
  exportedByUserId String           @map("exported_by_user_id")
  exportedAt       DateTime         @default(now()) @map("exported_at")
  agencyTenant     Tenant           @relation("AgencyExportEvents", fields: [agencyTenantId], references: [id], onDelete: Cascade)
  clientTenant     Tenant           @relation("ClientExportEvents", fields: [clientTenantId], references: [id], onDelete: Cascade)
  exportLog        AgencyExportLog? @relation(fields: [exportLogId], references: [id])
  exportedByUser   User             @relation("InvoiceExportEventUser", fields: [exportedByUserId], references: [id])
  invoice          Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, agencyTenantId])
  @@index([agencyTenantId, clientTenantId])
  @@index([exportLogId])
  @@map("invoice_export_events")
}

model RecurringInvoice {
  id                      String                 @id @default(uuid())
  tenantId                String                 @map("tenant_id")
  customerId              String                 @map("customer_id")
  seriesId                String?                @map("series_id")
  frequency               Frequency
  dayOfMonth              Int                    @default(1) @map("day_of_month")
  startDate               DateTime               @map("start_date") @db.Date
  endDate                 DateTime?              @map("end_date") @db.Date
  nextRunDate             DateTime               @map("next_run_date") @db.Date
  autoConfirm             Boolean                @default(false) @map("auto_confirm")
  status                  RecurringStatus        @default(ACTIVE)
  discountPercent         Decimal?               @map("discount_percent") @db.Decimal(5, 2)
  irpfPercent             Decimal?               @map("irpf_percent") @db.Decimal(5, 2)
  paymentMethod           PaymentMethod?         @map("payment_method")
  paymentDetails          Json?                  @map("payment_details")
  notes                   String?
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  createdByUserId         String?                @map("created_by_user_id")
  estimatedTotal          Decimal                @default(0) @map("estimated_total") @db.Decimal(15, 2)
  compensacionPercent     Decimal?               @map("compensacion_percent") @db.Decimal(5, 2)
  layoutOverride          Json?                  @map("layout_override")
  hasEquivalenceSurcharge Boolean                @default(false) @map("has_equivalence_surcharge")
  generatedInvoices       Invoice[]
  lines                   RecurringInvoiceLine[]
  createdByUser           User?                  @relation("RecurringInvoiceCreatedBy", fields: [createdByUserId], references: [id])
  customer                Customer               @relation(fields: [customerId], references: [id])
  series                  InvoiceSeries?         @relation(fields: [seriesId], references: [id])
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([nextRunDate, status])
  @@index([createdByUserId])
  @@map("recurring_invoices")
}

model RecurringInvoiceLine {
  id                 String           @id @default(uuid())
  tenantId           String           @map("tenant_id")
  recurringInvoiceId String           @map("recurring_invoice_id")
  productId          String?          @map("product_id")
  description        String
  quantity           Decimal          @db.Decimal(12, 4)
  unitPrice          Decimal          @map("unit_price") @db.Decimal(12, 4)
  taxRate            Decimal          @map("tax_rate") @db.Decimal(5, 2)
  irpfRate           Decimal?         @map("irpf_rate") @db.Decimal(5, 2)
  hideQty            Boolean          @default(false) @map("hide_qty")
  sortOrder          Int              @default(0) @map("sort_order")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  discountPercent    Decimal?         @map("discount_percent") @db.Decimal(5, 2)
  surchargeRate      Decimal?         @map("surcharge_rate") @db.Decimal(5, 2)
  product            Product?         @relation(fields: [productId], references: [id])
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)

  @@index([recurringInvoiceId])
  @@index([tenantId])
  @@map("recurring_invoice_lines")
}

model ExpenseCategory {
  id                String             @id @default(uuid())
  slug              String             @unique
  name              String
  sortOrder         Int                @default(0) @map("sort_order")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@map("expense_categories")
}

model Supplier {
  id                String             @id @default(uuid())
  tenantId          String             @map("tenant_id")
  name              String
  legalName         String?            @map("legal_name")
  taxId             String?            @map("tax_id")
  email             String?
  phone             String?
  address           String?
  postalCode        String?            @map("postal_code")
  city              String?
  province          String?
  country           String             @default("ES")
  notes             String?
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "suppliers_name_trgm_idx", type: Gin)
  @@index([taxId(ops: raw("gin_trgm_ops"))], map: "suppliers_tax_id_trgm_idx", type: Gin)
  @@map("suppliers")
}

model ExpenseAttachment {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  expenseId  String?   @map("expense_id")
  fileName   String    @map("file_name")
  mimeType   String    @map("mime_type")
  size       Int
  storageKey String    @unique @map("storage_key")
  createdAt  DateTime  @default(now()) @map("created_at")
  content    String?
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expense    Expense[]

  @@index([tenantId])
  @@index([expenseId])
  @@map("expense_attachments")
}

model Expense {
  id                 String             @id @default(uuid())
  tenantId           String             @map("tenant_id")
  date               DateTime           @db.Date
  description        String
  categoryId         String             @map("category_id")
  supplierId         String?            @map("supplier_id")
  clientId           String?            @map("client_id")
  baseAmount         Decimal            @map("base_amount") @db.Decimal(12, 2)
  vatRate            Decimal            @map("vat_rate") @db.Decimal(5, 2)
  vatAmount          Decimal            @map("vat_amount") @db.Decimal(12, 2)
  totalAmount        Decimal            @map("total_amount") @db.Decimal(12, 2)
  notes              String?
  attachmentId       String?            @map("attachment_id")
  createdByUserId    String?            @map("created_by_user_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  recurringExpenseId String?            @map("recurring_expense_id")
  attachment         ExpenseAttachment? @relation(fields: [attachmentId], references: [id])
  category           ExpenseCategory    @relation(fields: [categoryId], references: [id])
  client             Customer?          @relation(fields: [clientId], references: [id])
  createdByUser      User?              @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  recurringExpense   RecurringExpense?  @relation("RecurringExpenseGenerated", fields: [recurringExpenseId], references: [id])
  supplier           Supplier?          @relation(fields: [supplierId], references: [id])
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, categoryId])
  @@index([tenantId, supplierId])
  @@index([tenantId, clientId])
  @@index([tenantId, recurringExpenseId])
  @@index([tenantId, date, categoryId, supplierId, clientId])
  @@index([description(ops: raw("gin_trgm_ops"))], map: "expenses_description_trgm_idx", type: Gin)
  @@map("expenses")
}

model RecurringExpense {
  id                String                    @id @default(uuid())
  tenantId          String                    @map("tenant_id")
  description       String
  categoryId        String                    @map("category_id")
  supplierId        String?                   @map("supplier_id")
  clientId          String?                   @map("client_id")
  baseAmount        Decimal                   @map("base_amount") @db.Decimal(12, 2)
  vatRate           Decimal                   @map("vat_rate") @db.Decimal(5, 2)
  vatAmount         Decimal                   @map("vat_amount") @db.Decimal(12, 2)
  totalAmount       Decimal                   @map("total_amount") @db.Decimal(12, 2)
  frequency         RecurringExpenseFrequency
  startDate         DateTime                  @map("start_date") @db.Date
  endDate           DateTime?                 @map("end_date") @db.Date
  lastGeneratedDate DateTime?                 @map("last_generated_date") @db.Date
  isActive          Boolean                   @default(true) @map("is_active")
  notes             String?
  createdByUserId   String?                   @map("created_by_user_id")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  generatedExpenses Expense[]                 @relation("RecurringExpenseGenerated")
  category          ExpenseCategory           @relation(fields: [categoryId], references: [id])
  client            Customer?                 @relation(fields: [clientId], references: [id])
  createdByUser     User?                     @relation("RecurringExpenseCreatedBy", fields: [createdByUserId], references: [id])
  supplier          Supplier?                 @relation(fields: [supplierId], references: [id])
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, frequency])
  @@index([description(ops: raw("gin_trgm_ops"))], map: "recurring_expenses_description_trgm_idx", type: Gin)
  @@map("recurring_expenses")
}

