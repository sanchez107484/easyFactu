generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== TENANTS ====================

model Tenant {
  id               String      @id @default(uuid())
  businessName     String      @map("business_name")
  legalName        String?     @map("legal_name")
  nif              String      @unique
  address          String
  postalCode       String      @map("postal_code")
  city             String
  province         String
  country          String      @default("ES")
  phone            String?
  email            String
  logoUrl          String?     @map("logo_url")
  iban             String?
  bankAccountHolder String?    @map("bank_account_holder")
  bic              String?
  certificateUrl   String?     @map("certificate_url")
  certificateExpiry DateTime?  @map("certificate_expiry")
  setupCompleted   Boolean     @default(false) @map("setup_completed")
  accountType      AccountType @default(INDIVIDUAL) @map("account_type")
  plan             Plan        @default(FREE)
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  tenantUsers        TenantUser[]
  customers          Customer[]
  products           Product[]
  invoices           Invoice[]
  invoiceSeries      InvoiceSeries[]
  invoiceTemplates   InvoiceTemplate[]
  verifactuLogs      VerifactuLog[]
  invoiceDefaults    InvoiceDefaults?
  invoiceNoteLogs    InvoiceNoteLog[]
  recurringInvoices  RecurringInvoice[]
  payments           Payment[]

  // Agency relations
  preferredExportFormat   ExportFormat?           @map("preferred_export_format")
  agencyRelations         AgencyClientRelation[]  @relation("AgencyRelations")
  clientRelations         AgencyClientRelation[]  @relation("ClientRelations")
  agencyInvitations       AgencyInvitation[]
  agencyExportLogs        AgencyExportLog[]        @relation("AgencyExportLogs")
  clientExportLogs        AgencyExportLog[]        @relation("ClientExportLogs")
  agencyRelationHistory   AgencyRelationHistory[] @relation("AgencyHistoryRelations")
  clientRelationHistory   AgencyRelationHistory[] @relation("ClientHistoryRelations")
  agencyExportEvents      InvoiceExportEvent[]    @relation("AgencyExportEvents")
  clientExportEvents      InvoiceExportEvent[]    @relation("ClientExportEvents")
  impersonationLogsAsAgency AgencyImpersonationLog[] @relation("ImpersonationAgencyTenant")
  impersonationLogsAsClient AgencyImpersonationLog[] @relation("ImpersonationClientTenant")

  @@index([email])
  @@index([accountType], map: "tenants_account_type_idx")
  @@map("tenants")
}

enum AccountType {
  INDIVIDUAL      // AutÃ³nomo individual
  BUSINESS        // Empresa con empleados
  AGENCY          // GestorÃ­a/asesorÃ­a que gestiona mÃºltiples clientes
  COLLABORATIVE   // AutÃ³nomos colaborando
}

enum Plan {
  FREE
  BASIC
  PROFESSIONAL
}

// ==================== TENANT-USER RELATIONSHIP (Many-to-Many) ====================

model TenantUser {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  userId      String         @map("user_id")
  role        TenantUserRole @default(ADMIN)
  isOwner     Boolean        @default(false) @map("is_owner")
  joinedAt    DateTime       @default(now()) @map("joined_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_users")
}

enum TenantUserRole {
  OWNER       // Propietario (puede eliminar tenant, gestionar usuarios)
  ADMIN       // Administrador (acceso total excepto eliminar tenant)
  ACCOUNTANT  // Contable (solo facturaciÃ³n e informes)
  VIEWER      // Solo lectura
}

// ==================== USERS ====================

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String?  @map("password_hash")
  firstName        String   @default("") @map("first_name")
  lastName         String   @default("") @map("last_name")
  emailVerified    Boolean  @default(false) @map("email_verified")
  emailVerifyToken String?  @map("email_verify_token")
  resetPasswordToken String? @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  accountActivationToken   String?   @map("account_activation_token")
  accountActivationExpires DateTime? @map("account_activation_expires")
  refreshToken     String?  @map("refresh_token") @db.Text
  isActive         Boolean  @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at")
  lastActiveTenantId String? @map("last_active_tenant_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenantUsers              TenantUser[]
  agencyExportLogs         AgencyExportLog[]    @relation("AgencyExportLogUser")
  invoiceExportEvents      InvoiceExportEvent[] @relation("InvoiceExportEventUser")
  invoicesCreated          Invoice[]            @relation("InvoiceCreatedBy")
  recurringInvoicesCreated RecurringInvoice[]   @relation("RecurringInvoiceCreatedBy")
  impersonationLogs        AgencyImpersonationLog[] @relation("ImpersonationActor")

  @@map("users")
}

// Removed UserRole enum - now using TenantUserRole in TenantUser model

// ==================== CUSTOMERS ====================

model Customer {
  id               String       @id @default(uuid())
  tenantId         String       @map("tenant_id")
  type             CustomerType @default(COMPANY)
  name             String
  legalName        String?      @map("legal_name")
  nif              String
  email            String?
  phone            String?
  address          String?
  postalCode       String?      @map("postal_code")
  city             String?
  province         String?
  country          String       @default("ES")
  contactPerson    String?      @map("contact_person")
  notes            String?      @db.Text
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  recurringInvoices RecurringInvoice[]

  @@unique([tenantId, nif])
  @@index([tenantId])
  @@index([tenantId, isActive])
  // GIN trigram indexes — enable ILIKE '%text%' to use index instead of seq scan.
  // Managed via raw migration SQL (CREATE EXTENSION pg_trgm required).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_name_trgm_idx")
  @@index([legalName(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_legal_name_trgm_idx")
  @@index([nif(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_nif_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_email_trgm_idx")
  @@map("customers")
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
  SELF_EMPLOYED
  PUBLIC_ENTITY
  INTRACOMMUNITY
}

// ==================== PRODUCTS ====================

model Product {
  id               String      @id @default(uuid())
  tenantId         String      @map("tenant_id")
  type             ProductType @default(SERVICE)
  name             String
  description      String?     @db.Text
  reference        String?
  unitPrice        Decimal     @map("unit_price") @db.Decimal(12, 2)
  taxRate          Decimal     @map("tax_rate") @db.Decimal(5, 2)
  unit             String      @default("unidad")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceLines     InvoiceLine[]
  recurringLines   RecurringInvoiceLine[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  // GIN trigram indexes — enable ILIKE '%text%' to use index instead of seq scan.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([reference(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_reference_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_description_trgm_idx")
  @@map("products")
}

enum ProductType {
  PRODUCT
  SERVICE
}

// ==================== INVOICE TEMPLATES ====================

model InvoiceTemplate {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String   @default("Plantilla predeterminada")
  isDefault   Boolean  @default(false) @map("is_default")
  layout      Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")


  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices    Invoice[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isDefault])
  @@map("invoice_templates")
}

// ==================== INVOICE SERIES ====================

model InvoiceSeries {
  id               String     @id @default(uuid())
  tenantId         String     @map("tenant_id")
  code             String
  name             String
  type             SeriesType @default(INVOICE)
  prefix           String
  nextNumber       Int        @default(1) @map("next_number")
  digits           Int        @default(4)
  year             Int
  isDefault        Boolean    @default(false) @map("is_default")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  recurringInvoices RecurringInvoice[]

  @@unique([tenantId, code, year])
  @@index([tenantId])
  @@index([tenantId, isDefault])
  @@map("invoice_series")
}

enum SeriesType {
  INVOICE
  RECTIFICATIVE
  QUOTE
}

// invoiceType: valores en minúsculas para mantener la misma API contract que el string original
enum InvoiceType {
  standard
  simplified
  proforma
  quote
}

// ==================== INVOICES ====================

model Invoice {
  id                  String         @id @default(uuid())
  tenantId            String         @map("tenant_id")
  seriesId            String         @map("series_id")
  customerId          String         @map("customer_id")
  number              String?
  issueDate           DateTime       @map("issue_date") @db.Date
  dueDate             DateTime?      @map("due_date") @db.Date
  status              InvoiceStatus  @default(DRAFT)
  subtotal            Decimal        @db.Decimal(12, 2)
  discountPercent     Decimal?       @map("discount_percent") @db.Decimal(5, 2)
  discountAmount      Decimal?       @map("discount_amount") @db.Decimal(12, 2)
  taxTotal            Decimal        @map("tax_total") @db.Decimal(12, 2)
  irpfPercent         Decimal?       @map("irpf_percent") @db.Decimal(5, 2)
  irpfTotal           Decimal?       @map("irpf_total") @db.Decimal(12, 2)
  total               Decimal        @db.Decimal(12, 2)
  paymentMethod       PaymentMethod? @map("payment_method")
  notes               String?        @db.Text
  paymentDetails      Json?          @map("payment_details")

  invoiceType         InvoiceType    @default(standard) @map("invoice_type")

  // Quote-specific fields
  validUntil          DateTime?      @map("valid_until") @db.Date
  quoteAcceptanceStatus QuoteAcceptanceStatus? @map("quote_acceptance_status")
  convertedToInvoiceId String?        @map("converted_to_invoice_id")

  templateId          String?        @map("template_id")
  layoutOverride      Json?          @map("layout_override")
  pdfUrl              String?        @map("pdf_url")
  hash                String?        @unique
  prevHash            String?        @map("prev_hash")
  verifactuStatus     VerifactuStatus? @map("verifactu_status")
  verifactuQr         String?        @map("verifactu_qr") @db.Text
  verifactuSentAt     DateTime?      @map("verifactu_sent_at")
  verifactuResponse   Json?          @map("verifactu_response")
  isRectificative     Boolean        @default(false) @map("is_rectificative")
  rectifiedInvoiceId  String?        @map("rectified_invoice_id")
  rectificationReason String?        @map("rectification_reason") @db.Text
  amountPaid          Decimal        @default(0) @map("amount_paid") @db.Decimal(12, 2)
  paymentStatus       PaymentStatus  @default(UNPAID) @map("payment_status")
  createdByUserId     String?        @map("created_by_user_id")
  recurringInvoiceId  String?        @map("recurring_invoice_id")

  // ── Customer snapshot — immutable copy of the customer's billing data at creation/confirmation.
  // All fields nullable for backwards-compatibility with invoices created before this migration.
  customerSnapshotName        String?  @map("customer_snapshot_name")
  customerSnapshotLegalName   String?  @map("customer_snapshot_legal_name")
  customerSnapshotNif         String?  @map("customer_snapshot_nif")
  customerSnapshotType        String?  @map("customer_snapshot_type")
  customerSnapshotEmail       String?  @map("customer_snapshot_email")
  customerSnapshotPhone       String?  @map("customer_snapshot_phone")
  customerSnapshotAddress     String?  @map("customer_snapshot_address")
  customerSnapshotPostalCode  String?  @map("customer_snapshot_postal_code")
  customerSnapshotCity        String?  @map("customer_snapshot_city")
  customerSnapshotProvince    String?  @map("customer_snapshot_province")
  customerSnapshotCountry     String?  @map("customer_snapshot_country")

  // ── Issuer snapshot — immutable copy of the tenant's billing data at creation/confirmation.
  // All fields nullable for backwards-compatibility with invoices created before this migration.
  issuerSnapshotName          String?  @map("issuer_snapshot_name")
  issuerSnapshotLegalName     String?  @map("issuer_snapshot_legal_name")
  issuerSnapshotNif           String?  @map("issuer_snapshot_nif")
  issuerSnapshotEmail         String?  @map("issuer_snapshot_email")
  issuerSnapshotPhone         String?  @map("issuer_snapshot_phone")
  issuerSnapshotAddress       String?  @map("issuer_snapshot_address")
  issuerSnapshotPostalCode    String?  @map("issuer_snapshot_postal_code")
  issuerSnapshotCity          String?  @map("issuer_snapshot_city")
  issuerSnapshotProvince      String?  @map("issuer_snapshot_province")
  issuerSnapshotCountry       String?  @map("issuer_snapshot_country")

  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  series              InvoiceSeries  @relation(fields: [seriesId], references: [id])
  customer            Customer       @relation(fields: [customerId], references: [id])
  template            InvoiceTemplate? @relation(fields: [templateId], references: [id])
  createdByUser       User?          @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  rectifiedInvoice    Invoice?       @relation("RectifiedInvoice", fields: [rectifiedInvoiceId], references: [id])
  rectificativeInvoices Invoice[]    @relation("RectifiedInvoice")
  lines               InvoiceLine[]
  payments            Payment[]
  verifactuLogs       VerifactuLog[]
  noteLogs            InvoiceNoteLog[]
  recurringInvoice    RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)

  exportEvents        InvoiceExportEvent[]

  // Uniqueness on (tenantId, number) is enforced via a raw partial unique index
  // (WHERE number IS NOT NULL) defined in migration 20260304220000_fix_invoice_number_partial_unique.
  // This allows multiple DRAFT invoices (number = null) per tenant while preventing duplicate
  // confirmed invoice numbers. Do NOT add @@unique here — Prisma would create a full unique index.
  @@index([tenantId, number], map: "invoices_tenant_id_number_idx")
  @@index([tenantId])
  @@index([tenantId, issueDate])
  @@index([tenantId, status])
  @@index([tenantId, status, issueDate])
  @@index([tenantId, customerId])
  @@index([tenantId, seriesId])
  @@index([tenantId, dueDate])
  @@index([tenantId, total])
  @@index([tenantId, createdAt])
  @@index([tenantId, paymentStatus])
  @@index([createdByUserId])
  @@index([recurringInvoiceId])
  // GIN trigram index — enables ILIKE '%text%' on invoice number without seq scan.
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "invoices_number_trgm_idx")
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  PROFORMA
  QUOTE
  CONFIRMED
  SENT
  PAID
  RECTIFIED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum QuoteAcceptanceStatus {
  PENDING
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

enum VerifactuStatus {
  PENDING
  SENDING
  ACCEPTED
  ACCEPTED_WITH_WARNINGS
  REJECTED
  ERROR
}

enum PaymentMethod {
  BANK_TRANSFER
  DIRECT_DEBIT
  CARD
  CASH
  PAYPAL
  OTHER
  BIZUM
}

// ==================== INVOICE LINES ====================

model InvoiceLine {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  invoiceId        String   @map("invoice_id")
  productId        String?  @map("product_id")
  description      String
  quantity         Decimal  @db.Decimal(12, 4)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal         Decimal  @db.Decimal(12, 2)
  taxRate          Decimal  @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        Decimal  @map("tax_amount") @db.Decimal(12, 2)
  irpfRate         Decimal? @map("irpf_rate") @db.Decimal(5, 2)
  irpfAmount       Decimal? @map("irpf_amount") @db.Decimal(12, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(12, 2)
  hideQty          Boolean  @default(false) @map("hide_qty")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([tenantId])
  @@map("invoice_lines")
}

// ==================== PAYMENTS ====================

model Payment {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  invoiceId     String         @map("invoice_id")
  amount        Decimal        @db.Decimal(12, 2)
  paymentDate   DateTime       @map("payment_date") @db.Date
  paymentMethod PaymentMethod? @map("payment_method")
  reference     String?
  notes         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@map("payments")
}

// ==================== VERIFACTU LOGS ====================

model VerifactuLog {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  invoiceId        String   @map("invoice_id")
  action           String
  requestXml       String?  @map("request_xml") @db.Text
  responseXml      String?  @map("response_xml") @db.Text
  statusCode       Int?     @map("status_code")
  errorMessage     String?  @map("error_message") @db.Text
  attempt          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([invoiceId, createdAt(sort: Desc)], map: "verifactu_logs_invoice_created_at_idx")
  @@index([createdAt])
  @@map("verifactu_logs")
}

// ==================== INVOICE DEFAULTS ====================

model InvoiceDefaults {
  id             String         @id @default(uuid())
  tenantId       String         @unique @map("tenant_id")
  paymentMethod  PaymentMethod? @map("payment_method")
  paymentDetails Json?          @map("payment_details")
  irpfPercent    Decimal?       @map("irpf_percent") @db.Decimal(5, 2)
  dueDays        Int?           @map("due_days")
  notes          String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invoice_defaults")
}

// ==================== INVOICE NOTE LOGS ====================

model InvoiceNoteLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  invoiceId     String   @map("invoice_id")
  userId        String   @map("user_id")
  previousNotes String?  @map("previous_notes") @db.Text
  newNotes      String?  @map("new_notes") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([tenantId])
  @@map("invoice_note_logs")
}

// ==================== AGENCY MODULE ====================

enum RelationTerminator {
  AGENCY
  CLIENT
}

enum AgencyInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model AgencyClientRelation {
  id             String   @id @default(uuid())
  agencyTenantId String   @map("agency_tenant_id")
  clientTenantId String   @map("client_tenant_id")
  addedByUserId  String   @map("added_by_user_id")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  agencyTenant   Tenant   @relation("AgencyRelations", fields: [agencyTenantId], references: [id], onDelete: Cascade)
  clientTenant   Tenant   @relation("ClientRelations", fields: [clientTenantId], references: [id], onDelete: Cascade)

  @@unique([agencyTenantId, clientTenantId])
  @@index([agencyTenantId])
  @@index([clientTenantId])
  @@map("agency_client_relations")
}

// Permanent audit trail of every time an agency user impersonates (acts as) a managed client.
// Critical for compliance and traceability — records are append-only.
model AgencyImpersonationLog {
  id              String   @id @default(uuid())
  agencyTenantId  String   @map("agency_tenant_id")
  clientTenantId  String   @map("client_tenant_id")
  actorUserId     String   @map("actor_user_id")
  actorEmail      String   @map("actor_email")
  // Snapshot of the client name at the moment of impersonation (immutable for audit)
  clientBusinessName String @map("client_business_name")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent") @db.Text
  startedAt       DateTime @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")

  agencyTenant    Tenant   @relation("ImpersonationAgencyTenant", fields: [agencyTenantId], references: [id], onDelete: Cascade)
  clientTenant    Tenant   @relation("ImpersonationClientTenant", fields: [clientTenantId], references: [id], onDelete: Cascade)
  actorUser       User     @relation("ImpersonationActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([agencyTenantId, startedAt(sort: Desc)])
  @@index([clientTenantId, startedAt(sort: Desc)])
  @@index([actorUserId])
  @@map("agency_impersonation_logs")
}

model AgencyInvitation {
  id             String                 @id @default(uuid())
  agencyTenantId String                 @map("agency_tenant_id")
  inviteeEmail   String                 @map("invitee_email")
  inviteeName    String?                @map("invitee_name")
  token          String                 @unique
  status         AgencyInvitationStatus @default(PENDING)
  expiresAt      DateTime               @map("expires_at")
  rejectedAt     DateTime?              @map("rejected_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  agencyTenant   Tenant                 @relation(fields: [agencyTenantId], references: [id], onDelete: Cascade)

  @@index([agencyTenantId])
  @@index([inviteeEmail])
  @@index([token])
  @@map("agency_invitations")
}

// Audit trail: permanent record of every asesoría–client relationship.
// Rows are NEVER deleted — they are the legal proof of who managed whom and when.
model AgencyRelationHistory {
  id                 String              @id @default(uuid())
  agencyTenantId     String              @map("agency_tenant_id")
  clientTenantId     String              @map("client_tenant_id")
  // Snapshots of business names at the moment the relationship was created.
  // Preserved even if the tenant later changes its razón social.
  agencyBusinessName String              @map("agency_business_name") @db.VarChar(255)
  clientBusinessName String              @map("client_business_name") @db.VarChar(255)
  clientNif          String              @map("client_nif") @db.VarChar(20)
  startedAt          DateTime            @map("started_at")
  endedAt            DateTime?           @map("ended_at")           // null → relationship still active
  terminatedBy       RelationTerminator? @map("terminated_by")      // who initiated the revocation
  terminatedByUserId String?             @map("terminated_by_user_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  // onDelete: Restrict — we must NEVER lose this audit trail when a tenant is removed.
  // Tenants with history must be anonymised, not hard-deleted.
  agencyTenant       Tenant              @relation("AgencyHistoryRelations", fields: [agencyTenantId], references: [id], onDelete: Restrict)
  clientTenant       Tenant              @relation("ClientHistoryRelations", fields: [clientTenantId], references: [id], onDelete: Restrict)

  @@index([agencyTenantId])
  @@index([clientTenantId])
  @@index([agencyTenantId, clientTenantId])
  @@index([endedAt])         // fast queries for open relationships
  @@map("agency_relation_history")
}

// ==================== AGENCY EXPORT LOGS ====================

enum ExportFormat {
  CEGID
  CONTAPLUS
  A3CON
  DIAMACON
}

enum ExportMode {
  PENDING  // Only invoices not yet exported by this agency
  PERIOD   // All confirmed invoices in a date range
  MANUAL   // Specific invoice IDs selected by the user
}

model AgencyExportLog {
  id               String       @id @default(uuid())
  agencyTenantId   String       @map("agency_tenant_id")
  clientTenantId   String       @map("client_tenant_id")
  requestedByUserId String      @map("requested_by_user_id")
  format           ExportFormat
  mode             ExportMode   @default(PERIOD)
  year             Int?         // null for PENDING/MANUAL modes without a specific year
  quarter          Int?         // null = full year (only relevant for PERIOD mode)
  dateFrom         DateTime?    @map("date_from") @db.Date
  dateTo           DateTime?    @map("date_to") @db.Date
  invoicesCount    Int          @map("invoices_count")
  totalRevenue     Decimal      @map("total_revenue") @db.Decimal(12, 2)
  createdAt        DateTime     @default(now()) @map("created_at")

  agencyTenant        Tenant              @relation("AgencyExportLogs", fields: [agencyTenantId], references: [id], onDelete: Cascade)
  clientTenant        Tenant              @relation("ClientExportLogs", fields: [clientTenantId], references: [id], onDelete: Cascade)
  requestedByUser     User                @relation("AgencyExportLogUser", fields: [requestedByUserId], references: [id])
  invoiceExportEvents InvoiceExportEvent[]

  @@index([agencyTenantId])
  @@index([clientTenantId])
  @@index([agencyTenantId, createdAt])
  @@map("agency_export_logs")
}

// Tracks every individual invoice exported by an agency.
// Source of truth for the "Pendientes" export mode.
model InvoiceExportEvent {
  id               String       @id @default(uuid())
  invoiceId        String       @map("invoice_id")
  agencyTenantId   String       @map("agency_tenant_id")
  clientTenantId   String       @map("client_tenant_id")
  exportLogId      String?      @map("export_log_id")
  format           ExportFormat
  exportedByUserId String       @map("exported_by_user_id")
  exportedAt       DateTime     @default(now()) @map("exported_at")

  invoice          Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  agencyTenant     Tenant           @relation("AgencyExportEvents", fields: [agencyTenantId], references: [id], onDelete: Cascade)
  clientTenant     Tenant           @relation("ClientExportEvents", fields: [clientTenantId], references: [id], onDelete: Cascade)
  exportLog        AgencyExportLog? @relation(fields: [exportLogId], references: [id], onDelete: SetNull)
  exportedByUser   User             @relation("InvoiceExportEventUser", fields: [exportedByUserId], references: [id])

  @@index([invoiceId, agencyTenantId])
  @@index([agencyTenantId, clientTenantId])
  @@index([exportLogId])
  @@map("invoice_export_events")
}

// ==================== RECURRING INVOICES ====================

enum Frequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model RecurringInvoice {
  id             String          @id @default(uuid())
  tenantId       String          @map("tenant_id")
  customerId     String          @map("customer_id")
  seriesId       String?         @map("series_id")
  frequency      Frequency
  dayOfMonth     Int             @default(1) @map("day_of_month")
  startDate      DateTime        @map("start_date") @db.Date
  endDate        DateTime?       @map("end_date") @db.Date
  nextRunDate    DateTime        @map("next_run_date") @db.Date
  autoConfirm    Boolean         @default(false) @map("auto_confirm")
  status         RecurringStatus @default(ACTIVE)
  discountPercent Decimal?       @map("discount_percent") @db.Decimal(5, 2)
  irpfPercent    Decimal?        @map("irpf_percent") @db.Decimal(5, 2)
  estimatedTotal Decimal         @default(0) @map("estimated_total") @db.Decimal(15, 2)
  paymentMethod  PaymentMethod?  @map("payment_method")
  paymentDetails Json?           @map("payment_details")
  notes          String?         @db.Text
  createdByUserId String?        @map("created_by_user_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer        @relation(fields: [customerId], references: [id])
  series         InvoiceSeries?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdByUser  User?           @relation("RecurringInvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines          RecurringInvoiceLine[]
  generatedInvoices Invoice[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([nextRunDate, status])
  @@index([createdByUserId])
  @@map("recurring_invoices")
}

model RecurringInvoiceLine {
  id                 String           @id @default(uuid())
  tenantId           String           @map("tenant_id")
  recurringInvoiceId String           @map("recurring_invoice_id")
  productId          String?          @map("product_id")
  description        String
  quantity           Decimal          @db.Decimal(12, 4)
  unitPrice          Decimal          @map("unit_price") @db.Decimal(12, 2)
  taxRate            Decimal          @map("tax_rate") @db.Decimal(5, 2)
  irpfRate           Decimal?         @map("irpf_rate") @db.Decimal(5, 2)
  hideQty            Boolean          @default(false) @map("hide_qty")
  sortOrder          Int              @default(0) @map("sort_order")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  product            Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([recurringInvoiceId])
  @@index([tenantId])
  @@map("recurring_invoice_lines")
}
