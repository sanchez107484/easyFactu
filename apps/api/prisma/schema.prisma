generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"  
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== TENANTS ====================

model Tenant {
  id               String      @id @default(uuid())
  businessName     String      @map("business_name")
  legalName        String?     @map("legal_name")
  nif              String      @unique
  address          String
  postalCode       String      @map("postal_code")
  city             String
  province         String
  country          String      @default("ES")
  phone            String?
  email            String
  logoUrl          String?     @map("logo_url")
  iban             String?
  bankAccountHolder String?    @map("bank_account_holder")
  certificateUrl   String?     @map("certificate_url")
  certificateExpiry DateTime?  @map("certificate_expiry")
  setupCompleted   Boolean     @default(false) @map("setup_completed")
  accountType      AccountType @default(INDIVIDUAL) @map("account_type")
  plan             Plan        @default(FREE)
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  tenantUsers      TenantUser[]
  customers        Customer[]
  products         Product[]
  invoices         Invoice[]
  invoiceSeries    InvoiceSeries[]
  verifactuLogs    VerifactuLog[]

  @@map("tenants")
}

enum AccountType {
  INDIVIDUAL      // Autónomo individual
  BUSINESS        // Empresa con empleados
  AGENCY          // Gestoría/asesoría que gestiona múltiples clientes
  COLLABORATIVE   // Autónomos colaborando
}

enum Plan {
  FREE
  BASIC
  PROFESSIONAL
}

// ==================== TENANT-USER RELATIONSHIP (Many-to-Many) ====================

model TenantUser {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  userId      String         @map("user_id")
  role        TenantUserRole @default(ADMIN)
  isOwner     Boolean        @default(false) @map("is_owner")
  joinedAt    DateTime       @default(now()) @map("joined_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_users")
}

enum TenantUserRole {
  OWNER       // Propietario (puede eliminar tenant, gestionar usuarios)
  ADMIN       // Administrador (acceso total excepto eliminar tenant)
  ACCOUNTANT  // Contable (solo facturación e informes)
  VIEWER      // Solo lectura
}

// ==================== USERS ====================

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String   @map("password_hash")
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  emailVerified    Boolean  @default(false) @map("email_verified")
  emailVerifyToken String?  @map("email_verify_token")
  resetPasswordToken String? @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  refreshToken     String?  @map("refresh_token") @db.Text
  isActive         Boolean  @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at")
  lastActiveTenantId String? @map("last_active_tenant_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenantUsers      TenantUser[]

  @@map("users")
}

// Removed UserRole enum - now using TenantUserRole in TenantUser model

// ==================== CUSTOMERS ====================

model Customer {
  id               String       @id @default(uuid())
  tenantId         String       @map("tenant_id")
  type             CustomerType @default(COMPANY)
  name             String
  legalName        String?      @map("legal_name")
  nif              String
  email            String?
  phone            String?
  address          String?
  postalCode       String?      @map("postal_code")
  city             String?
  province         String?
  country          String       @default("ES")
  contactPerson    String?      @map("contact_person")
  notes            String?      @db.Text
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices         Invoice[]

  @@unique([tenantId, nif])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("customers")
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
  SELF_EMPLOYED
  INTRACOMMUNITY
}

// ==================== PRODUCTS ====================

model Product {
  id               String      @id @default(uuid())
  tenantId         String      @map("tenant_id")
  type             ProductType @default(SERVICE)
  name             String
  description      String?     @db.Text
  reference        String?
  unitPrice        Decimal     @map("unit_price") @db.Decimal(12, 2)
  taxRate          Decimal     @map("tax_rate") @db.Decimal(5, 2)
  unit             String      @default("unidad")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceLines     InvoiceLine[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("products")
}

enum ProductType {
  PRODUCT
  SERVICE
}

// ==================== INVOICE SERIES ====================

model InvoiceSeries {
  id               String     @id @default(uuid())
  tenantId         String     @map("tenant_id")
  code             String
  name             String
  type             SeriesType @default(INVOICE)
  prefix           String
  nextNumber       Int        @default(1) @map("next_number")
  digits           Int        @default(4)
  year             Int
  isDefault        Boolean    @default(false) @map("is_default")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices         Invoice[]

  @@unique([tenantId, code, year])
  @@index([tenantId])
  @@index([tenantId, isDefault])
  @@map("invoice_series")
}

enum SeriesType {
  INVOICE
  RECTIFICATIVE
}

// ==================== INVOICES ====================

model Invoice {
  id                  String         @id @default(uuid())
  tenantId            String         @map("tenant_id")
  seriesId            String         @map("series_id")
  customerId          String         @map("customer_id")
  number              String
  issueDate           DateTime       @map("issue_date") @db.Date
  dueDate             DateTime?      @map("due_date") @db.Date
  status              InvoiceStatus  @default(DRAFT)
  subtotal            Decimal        @db.Decimal(12, 2)
  discountPercent     Decimal?       @map("discount_percent") @db.Decimal(5, 2)
  discountAmount      Decimal?       @map("discount_amount") @db.Decimal(12, 2)
  taxTotal            Decimal        @map("tax_total") @db.Decimal(12, 2)
  irpfPercent         Decimal?       @map("irpf_percent") @db.Decimal(5, 2)
  irpfTotal           Decimal?       @map("irpf_total") @db.Decimal(12, 2)
  total               Decimal        @db.Decimal(12, 2)
  paymentMethod       PaymentMethod? @map("payment_method")
  notes               String?        @db.Text
  pdfUrl              String?        @map("pdf_url")
  hash                String?        @unique
  prevHash            String?        @map("prev_hash")
  verifactuStatus     VerifactuStatus? @map("verifactu_status")
  verifactuQr         String?        @map("verifactu_qr") @db.Text
  verifactuSentAt     DateTime?      @map("verifactu_sent_at")
  verifactuResponse   Json?          @map("verifactu_response")
  isRectificative     Boolean        @default(false) @map("is_rectificative")
  rectifiedInvoiceId  String?        @map("rectified_invoice_id")
  rectificationReason String?        @map("rectification_reason") @db.Text
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  series              InvoiceSeries  @relation(fields: [seriesId], references: [id])
  customer            Customer       @relation(fields: [customerId], references: [id])
  rectifiedInvoice    Invoice?       @relation("RectifiedInvoice", fields: [rectifiedInvoiceId], references: [id])
  rectificativeInvoices Invoice[]    @relation("RectifiedInvoice")
  lines               InvoiceLine[]
  verifactuLogs       VerifactuLog[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, issueDate])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, seriesId])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  SENT
  PAID
  RECTIFIED
}

enum VerifactuStatus {
  PENDING
  SENDING
  ACCEPTED
  ACCEPTED_WITH_WARNINGS
  REJECTED
  ERROR
}

enum PaymentMethod {
  BANK_TRANSFER
  DIRECT_DEBIT
  CARD
  CASH
  PAYPAL
  OTHER
}

// ==================== INVOICE LINES ====================

model InvoiceLine {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  invoiceId        String   @map("invoice_id")
  productId        String?  @map("product_id")
  description      String
  quantity         Decimal  @db.Decimal(12, 4)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal         Decimal  @db.Decimal(12, 2)
  taxRate          Decimal  @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        Decimal  @map("tax_amount") @db.Decimal(12, 2)
  irpfRate         Decimal? @map("irpf_rate") @db.Decimal(5, 2)
  irpfAmount       Decimal? @map("irpf_amount") @db.Decimal(12, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(12, 2)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([tenantId])
  @@map("invoice_lines")
}

// ==================== VERIFACTU LOGS ====================

model VerifactuLog {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  invoiceId        String   @map("invoice_id")
  action           String
  requestXml       String?  @map("request_xml") @db.Text
  responseXml      String?  @map("response_xml") @db.Text
  statusCode       Int?     @map("status_code")
  errorMessage     String?  @map("error_message") @db.Text
  attempt          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([createdAt])
  @@map("verifactu_logs")
}
