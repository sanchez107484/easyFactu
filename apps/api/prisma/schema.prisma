generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== TENANTS ====================

model Tenant {
  id               String      @id @default(uuid())
  businessName     String      @map("business_name")
  legalName        String?     @map("legal_name")
  nif              String      @unique
  address          String
  postalCode       String      @map("postal_code")
  city             String
  province         String
  country          String      @default("ES")
  phone            String?
  email            String
  logoUrl          String?     @map("logo_url")
  iban             String?
  bankAccountHolder String?    @map("bank_account_holder")
  bic              String?
  certificateUrl   String?     @map("certificate_url")
  certificateExpiry DateTime?  @map("certificate_expiry")
  setupCompleted   Boolean     @default(false) @map("setup_completed")
  accountType      AccountType @default(INDIVIDUAL) @map("account_type")
  plan             Plan        @default(FREE)
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  tenantUsers      TenantUser[]
  customers        Customer[]
  products         Product[]
  invoices         Invoice[]
  invoiceSeries    InvoiceSeries[]
  invoiceTemplates InvoiceTemplate[]
  verifactuLogs    VerifactuLog[]
  invoiceDefaults  InvoiceDefaults?
  invoiceNoteLogs  InvoiceNoteLog[]
  recurringInvoices RecurringInvoice[]
  recurringInvoiceLogs RecurringInvoiceLog[]

  @@map("tenants")
}

enum AccountType {
  INDIVIDUAL      // Autónomo individual
  BUSINESS        // Empresa con empleados
  AGENCY          // Gestoría/asesoría que gestiona múltiples clientes
  COLLABORATIVE   // Autónomos colaborando
}

enum Plan {
  FREE
  BASIC
  PROFESSIONAL
}

// ==================== TENANT-USER RELATIONSHIP (Many-to-Many) ====================

model TenantUser {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  userId      String         @map("user_id")
  role        TenantUserRole @default(ADMIN)
  isOwner     Boolean        @default(false) @map("is_owner")
  joinedAt    DateTime       @default(now()) @map("joined_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_users")
}

enum TenantUserRole {
  OWNER       // Propietario (puede eliminar tenant, gestionar usuarios)
  ADMIN       // Administrador (acceso total excepto eliminar tenant)
  ACCOUNTANT  // Contable (solo facturación e informes)
  VIEWER      // Solo lectura
}

// ==================== USERS ====================

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String   @map("password_hash")
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  emailVerified    Boolean  @default(false) @map("email_verified")
  emailVerifyToken String?  @map("email_verify_token")
  resetPasswordToken String? @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  refreshToken     String?  @map("refresh_token") @db.Text
  isActive         Boolean  @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at")
  lastActiveTenantId String? @map("last_active_tenant_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenantUsers      TenantUser[]

  @@map("users")
}

// Removed UserRole enum - now using TenantUserRole in TenantUser model

// ==================== CUSTOMERS ====================

model Customer {
  id               String       @id @default(uuid())
  tenantId         String       @map("tenant_id")
  type             CustomerType @default(COMPANY)
  name             String
  legalName        String?      @map("legal_name")
  nif              String
  email            String?
  phone            String?
  address          String?
  postalCode       String?      @map("postal_code")
  city             String?
  province         String?
  country          String       @default("ES")
  contactPerson    String?      @map("contact_person")
  notes            String?      @db.Text
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  recurringInvoices RecurringInvoice[]

  @@unique([tenantId, nif])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("customers")
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
  SELF_EMPLOYED
  INTRACOMMUNITY
}

// ==================== PRODUCTS ====================

model Product {
  id               String      @id @default(uuid())
  tenantId         String      @map("tenant_id")
  type             ProductType @default(SERVICE)
  name             String
  description      String?     @db.Text
  reference        String?
  unitPrice        Decimal     @map("unit_price") @db.Decimal(12, 2)
  taxRate          Decimal     @map("tax_rate") @db.Decimal(5, 2)
  unit             String      @default("unidad")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceLines     InvoiceLine[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("products")
}

enum ProductType {
  PRODUCT
  SERVICE
}

// ==================== INVOICE TEMPLATES ====================

model InvoiceTemplate {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String   @default("Plantilla predeterminada")
  isDefault   Boolean  @default(false) @map("is_default")
  layout      Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")


  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices    Invoice[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isDefault])
  @@map("invoice_templates")
}

// ==================== INVOICE SERIES ====================

model InvoiceSeries {
  id               String     @id @default(uuid())
  tenantId         String     @map("tenant_id")
  code             String
  name             String
  type             SeriesType @default(INVOICE)
  prefix           String
  nextNumber       Int        @default(1) @map("next_number")
  digits           Int        @default(4)
  year             Int
  isDefault        Boolean    @default(false) @map("is_default")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  recurringInvoices RecurringInvoice[]

  @@unique([tenantId, code, year])
  @@index([tenantId])
  @@index([tenantId, isDefault])
  @@map("invoice_series")
}

enum SeriesType {
  INVOICE
  RECTIFICATIVE
  QUOTE
}

// ==================== INVOICES ====================

model Invoice {
  id                  String         @id @default(uuid())
  tenantId            String         @map("tenant_id")
  seriesId            String         @map("series_id")
  customerId          String         @map("customer_id")
  number              String?
  issueDate           DateTime       @map("issue_date") @db.Date
  dueDate             DateTime?      @map("due_date") @db.Date
  status              InvoiceStatus  @default(DRAFT)
  subtotal            Decimal        @db.Decimal(12, 2)
  discountPercent     Decimal?       @map("discount_percent") @db.Decimal(5, 2)
  discountAmount      Decimal?       @map("discount_amount") @db.Decimal(12, 2)
  taxTotal            Decimal        @map("tax_total") @db.Decimal(12, 2)
  irpfPercent         Decimal?       @map("irpf_percent") @db.Decimal(5, 2)
  irpfTotal           Decimal?       @map("irpf_total") @db.Decimal(12, 2)
  total               Decimal        @db.Decimal(12, 2)
  paymentMethod       PaymentMethod? @map("payment_method")
  notes               String?        @db.Text
  paymentDetails      Json?          @map("payment_details")

  invoiceType         String?        @default("standard") @map("invoice_type")

  // Quote-specific fields
  validUntil          DateTime?      @map("valid_until") @db.Date
  quoteAcceptanceStatus QuoteAcceptanceStatus? @map("quote_acceptance_status")
  convertedToInvoiceId String?        @map("converted_to_invoice_id")

  templateId          String?        @map("template_id")
  layoutOverride      Json?          @map("layout_override")
  pdfUrl              String?        @map("pdf_url")
  hash                String?        @unique
  prevHash            String?        @map("prev_hash")
  verifactuStatus     VerifactuStatus? @map("verifactu_status")
  verifactuQr         String?        @map("verifactu_qr") @db.Text
  verifactuSentAt     DateTime?      @map("verifactu_sent_at")
  verifactuResponse   Json?          @map("verifactu_response")
  isRectificative     Boolean        @default(false) @map("is_rectificative")
  rectifiedInvoiceId  String?        @map("rectified_invoice_id")
  rectificationReason String?        @map("rectification_reason") @db.Text
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  series              InvoiceSeries  @relation(fields: [seriesId], references: [id])
  customer            Customer       @relation(fields: [customerId], references: [id])
  template            InvoiceTemplate? @relation(fields: [templateId], references: [id])
  rectifiedInvoice    Invoice?       @relation("RectifiedInvoice", fields: [rectifiedInvoiceId], references: [id])
  rectificativeInvoices Invoice[]    @relation("RectifiedInvoice")
  lines               InvoiceLine[]
  verifactuLogs       VerifactuLog[]
  noteLogs            InvoiceNoteLog[]
  recurringInvoiceLogs RecurringInvoiceLog[]

  // Uniqueness on (tenantId, number) is enforced via a raw partial unique index
  // (WHERE number IS NOT NULL) defined in migration 20260304220000_fix_invoice_number_partial_unique.
  // This allows multiple DRAFT invoices (number = null) per tenant while preventing duplicate
  // confirmed invoice numbers. Do NOT add @@unique here — Prisma would create a full unique index.
  @@index([tenantId, number], map: "invoices_tenant_id_number_idx")
  @@index([tenantId])
  @@index([tenantId, issueDate])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, seriesId])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  PROFORMA
  QUOTE
  CONFIRMED
  SENT
  PAID
  RECTIFIED
}

enum QuoteAcceptanceStatus {
  PENDING
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

enum VerifactuStatus {
  PENDING
  SENDING
  ACCEPTED
  ACCEPTED_WITH_WARNINGS
  REJECTED
  ERROR
}

enum PaymentMethod {
  BANK_TRANSFER
  DIRECT_DEBIT
  CARD
  CASH
  PAYPAL
  OTHER
  BIZUM
}

// ==================== INVOICE LINES ====================

model InvoiceLine {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  invoiceId        String   @map("invoice_id")
  productId        String?  @map("product_id")
  description      String
  quantity         Decimal  @db.Decimal(12, 4)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal         Decimal  @db.Decimal(12, 2)
  taxRate          Decimal  @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        Decimal  @map("tax_amount") @db.Decimal(12, 2)
  irpfRate         Decimal? @map("irpf_rate") @db.Decimal(5, 2)
  irpfAmount       Decimal? @map("irpf_amount") @db.Decimal(12, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(12, 2)
  hideQty          Boolean  @default(false) @map("hide_qty")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([tenantId])
  @@map("invoice_lines")
}

// ==================== VERIFACTU LOGS ====================

model VerifactuLog {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  invoiceId        String   @map("invoice_id")
  action           String
  requestXml       String?  @map("request_xml") @db.Text
  responseXml      String?  @map("response_xml") @db.Text
  statusCode       Int?     @map("status_code")
  errorMessage     String?  @map("error_message") @db.Text
  attempt          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([createdAt])
  @@map("verifactu_logs")
}

// ==================== INVOICE DEFAULTS ====================

model InvoiceDefaults {
  id             String         @id @default(uuid())
  tenantId       String         @unique @map("tenant_id")
  paymentMethod  PaymentMethod? @map("payment_method")
  paymentDetails Json?          @map("payment_details")
  irpfPercent    Decimal?       @map("irpf_percent") @db.Decimal(5, 2)
  dueDays        Int?           @map("due_days")
  notes          String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invoice_defaults")
}

// ==================== RECURRING INVOICES ====================

enum RecurringFrequency {
  MONTHLY
  BIMONTHLY   // Every 2 months
  QUARTERLY   // Every 3 months
  SEMIANNUAL  // Every 6 months
  ANNUAL
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model RecurringInvoice {
  id               String             @id @default(uuid())
  tenantId         String             @map("tenant_id")
  customerId       String             @map("customer_id")
  seriesId         String?            @map("series_id")
  name             String
  frequency        RecurringFrequency
  dayOfMonth       Int                @map("day_of_month")
  startDate        DateTime           @map("start_date") @db.Date
  endDate          DateTime?          @map("end_date") @db.Date
  maxOccurrences   Int?               @map("max_occurrences")
  occurrencesCount Int                @default(0) @map("occurrences_count")
  status           RecurringStatus    @default(ACTIVE)
  nextRunDate      DateTime?          @map("next_run_date") @db.Date
  pausedAt         DateTime?          @map("paused_at")
  lastRunAt        DateTime?          @map("last_run_at")

  // Template invoice data (stored as JSON)
  lines            Json
  discountPercent  Decimal?           @map("discount_percent") @db.Decimal(5, 2)
  irpfPercent      Decimal?           @map("irpf_percent") @db.Decimal(5, 2)
  paymentMethod    PaymentMethod?     @map("payment_method")
  paymentDetails   Json?              @map("payment_details")
  notes            String?            @db.Text
  dueDays          Int?               @map("due_days")

  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer           @relation(fields: [customerId], references: [id])
  series           InvoiceSeries?     @relation(fields: [seriesId], references: [id])
  generatedInvoices RecurringInvoiceLog[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([status, nextRunDate])
  @@map("recurring_invoices")
}

model RecurringInvoiceLog {
  id                 String           @id @default(uuid())
  tenantId           String           @map("tenant_id")
  recurringInvoiceId String           @map("recurring_invoice_id")
  invoiceId          String           @map("invoice_id")
  runDate            DateTime         @map("run_date") @db.Date
  createdAt          DateTime         @default(now()) @map("created_at")

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  invoice            Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([recurringInvoiceId])
  @@index([tenantId])
  @@map("recurring_invoice_logs")
}

// ==================== INVOICE NOTE LOGS ====================

model InvoiceNoteLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  invoiceId     String   @map("invoice_id")
  userId        String   @map("user_id")
  previousNotes String?  @map("previous_notes") @db.Text
  newNotes      String?  @map("new_notes") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([tenantId])
  @@map("invoice_note_logs")
}
