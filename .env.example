# ===========================================
# EASYFACTURA - ENVIRONMENT VARIABLES
# ===========================================
# Copia este archivo a .env y rellena con tus valores reales
# NUNCA commitees el archivo .env (está en .gitignore)

# ===========================================
# DATABASE (Supabase PostgreSQL)
# ===========================================
# Database URL con connection pooling (para queries de la app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"

# Direct URL sin pooling (para migraciones de Prisma)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Supabase Project URL
SUPABASE_URL="https://your-project.supabase.co"

# Supabase Service Role Key (backend only - NEVER expose to frontend)
SUPABASE_SERVICE_KEY="your-service-role-key"

# Supabase Anon Key (safe for frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Genera secrets seguros: openssl rand -base64 64
JWT_ACCESS_SECRET="your-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"

# Duración de tokens
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ===========================================
# BACKEND (NestJS)
# ===========================================
NODE_ENV="development"
PORT=3001
API_PREFIX="api/v1"

# CORS Origins (separados por coma)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ===========================================
# FRONTEND (Next.js)
# ===========================================
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===========================================
# EMAIL (Resend)
# ===========================================
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@easyfactura.es"
EMAIL_FROM_NAME="EasyFactura"

# ===========================================
# STORAGE (Supabase Storage)
# ===========================================
# Los buckets se gestionan desde Supabase Dashboard
# Buckets requeridos: certificates, invoices

# ===========================================
# VERIFACTU (AEAT)
# ===========================================
# URL de la AEAT para VeriFactu
AEAT_VERIFACTU_SANDBOX_URL="https://prewww1.aeat.es/wlpl/TIKE-CONT/ContribucionesRest"
AEAT_VERIFACTU_PRODUCTION_URL="https://www2.agenciatributaria.gob.es/wlpl/TIKE-CONT/ContribucionesRest"

# ===========================================
# RATE LIMITING
# ===========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ===========================================
# REDIS (opcional - para jobs/cache)
# ===========================================
# Si usas Redis local con Docker:
# REDIS_HOST="localhost"
# REDIS_PORT=6379
#
# Si usas Upstash Redis:
# UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"

# ===========================================
# MONITORING (opcional)
# ===========================================
# Sentry DSN para error tracking
# SENTRY_DSN="https://..."
